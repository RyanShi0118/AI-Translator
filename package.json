{
  "name": "lucid-translate",
  "private": true,
  "version": "1.3.0",
  "description": "Two-stage refine-then-translate browser extension (Manifest V3).",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "npm run typecheck && vite build && vite build -c vite.content.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "zip": "npm run build && cd dist && zip -r ../lucid.zip ."
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "@types/node": "^22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
